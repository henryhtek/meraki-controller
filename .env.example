# Copy this file to .env and fill in the values
# Never commit the real .env file

MERAKI_API_KEY=your_meraki_dashboard_api_key_here
SWITCH_SERIAL=Q2XX-XXXX-XXXX
AUTH_TOKEN=choose_a_long_random_secret_here_at_least_32_chars

# Optional – restrict which ports can be controlled (comma-separated)
# Leave empty or omit to allow any port
# ALLOWED_PORTS=7,12,24

# Cloudflare Tunnel token (from Zero Trust → Tunnels → your tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
